{
    "name": "jcvviljoen/php-stability-metrics",
    "description": "PHP tool to calculate architecture stability metrics based on clean architecture principles",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "php",
        "stability",
        "metrics",
        "clean",
        "architecture"
    ],
    "authors": [
        {
            "name": "Jason Viljoen",
            "email": "jcv.viljoen@gmail.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "ext-json": "*",
        "symfony/console": "^6.0|^7.0|^8.0",
        "tcds-io/php-jackson": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.0",
        "phpstan/phpstan": "^2.1.11",
        "slevomat/coding-standard": "^8.16.2"
    },
    "autoload": {
        "psr-4": {
            "Stability\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Stability\\Tests\\": "tests/"
        }
    },
    "bin": [
        "stability"
    ],
    "scripts": {
        "test:cs": "vendor/bin/phpcs --colors -ps",
        "test:stan": "vendor/bin/phpstan analyse --ansi",
        "test:unit": "vendor/bin/phpunit",
        "tests": [
            "@test:cs",
            "@test:stan",
            "@test:unit",
            "@test:stability"
        ],
        "test:stability": "php stability --fail-on-cycles"
    },
    "scripts-descriptions": {
        "test:cs": "Run PHP Code Sniffer to check standards (does not fix!).",
        "test:stan": "Run PHPStan to check for static analysis errors.",
        "test:unit": "Run PHPUnit to run unit tests.",
        "tests": "Run all tests.",
        "test:stability": "Run this project through its own analysis, failing on a circular dependency."
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": false
        }
    }
}
